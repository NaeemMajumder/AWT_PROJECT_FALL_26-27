# ==================================================================
#  TEAM A  (Naeem Majumder)
#  .env.example: copy to .env and fill real values. NEVER commit .env
#  Keys come from src/config/database.config.ts and src/config/app.config.ts
# ==================================================================

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_DATABASE=pet_bazaar

# --- App ---
PORT=5000
NODE_ENV=development
APP_ENV=local
FRONTEND_URL=http://localhost:3000

# --- JWT ---
JWT_BEARER_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_TTL=86400

# --- Redis (blueprint default; not used by Pet Bazaar MVP) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Mailer (required by blueprint app.config; dummy values are fine for MVP) ---
MAILER_HOST=localhost
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=dummy
MAILER_PASSWORD=dummy
MAILER_FROM=noreply@petbazaar.local

# --- Pet Bazaar rules (shorten for live demo) ---
PET_ORDER_PAY_WINDOW_HOURS=24
